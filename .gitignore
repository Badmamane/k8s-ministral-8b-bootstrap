# ------ Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
plan.txt
crash.log
crash.*.log
*_override.tf
*_override.tf.json

# ------ Local state of the bootstrap stack: it creates the bucket every other
# ------ stack stores its state in, so its own state stays on disk. Back it up.
state/

# ------ Variable files that may hold secrets (the per-account tfvars are committed)
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
secrets.tfvars

# ------ Credentials and keys, in case one ever lands in the tree
*.pem
*.key
*.p12
*.pfx
.env
.env.*
.envrc
.mise.local.toml

# ------ Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
